# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cocktail_maker
DB_USERNAME=cocktail_user
DB_PASSWORD=your_db_password

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# JWT配置
JWT_SECRET=your_jwt_secret_change_in_production

# 邮件配置
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# 文件存储配置
STORAGE_PATH=./uploads
STORAGE_URL_PREFIX=http://localhost:8080/api/uploads/

# 应用配置
APP_NAME=Cocktail Maker
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8000

# AI Agent 配置
AI_MODEL_TYPE=openai
AI_OPENAI_API_BASE=https://api.openai.com/v1
AI_OPENAI_API_KEY=sk-your-key-here
AI_OPENAI_CHAT_MODEL=gpt-4o-mini
AI_ONEAPI_API_BASE=http://localhost:3000/v1
AI_ONEAPI_API_KEY=sk-your-key-here
AI_ONEAPI_CHAT_MODEL=qwen-max
AI_OLLAMA_API_BASE=http://localhost:11434/v1
AI_OLLAMA_API_KEY=ollama
AI_OLLAMA_CHAT_MODEL=llama3.1:latest

# 环境设置
NODE_ENV=development
SPRING_PROFILES_ACTIVE=dev