# LLM 模型类型: openai | oneapi | ollama
MODEL_TYPE=openai

# OpenAI 配置
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_CHAT_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini

# OneAPI 配置（可选）
ONEAPI_API_BASE=http://localhost:3000/v1
ONEAPI_CHAT_API_KEY=sk-your-key-here
ONEAPI_CHAT_MODEL=qwen-max

# Ollama 本地模型配置（可选）
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_CHAT_API_KEY=ollama
OLLAMA_CHAT_MODEL=llama3.1:latest

# Java 后端地址
BACKEND_API_URL=http://localhost:8080/api

# 服务端口
PORT=8001
